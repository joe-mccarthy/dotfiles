#!/bin/sh

# Keep the desktop configuration independent of distro-specific browser names.
# I3_BROWSER and BROWSER should contain an executable name or absolute path.

self=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")

launch_browser() {
        browser_name="$1"
        shift

        case "$browser_name" in
                ''|i3-browser|xdg-open|gio)
                        return 1
                        ;;
        esac

        browser_path=$(command -v "$browser_name" 2>/dev/null || true)
        [ -n "$browser_path" ] || return 1

        resolved_path=$(readlink -f "$browser_path" 2>/dev/null || printf '%s' "$browser_path")
        [ "$resolved_path" != "$self" ] || return 1

        exec "$browser_path" "$@"
}

if [ -n "${I3_BROWSER:-}" ]; then
        launch_browser "$I3_BROWSER" "$@" || true
fi

if [ -n "${BROWSER:-}" ]; then
        launch_browser "$BROWSER" "$@" || true
fi

# Honour an existing non-wrapper XDG default before trying common executable
# names. gtk-launch accepts the desktop-file ID without the .desktop suffix.
if command -v xdg-settings >/dev/null 2>&1 && command -v gtk-launch >/dev/null 2>&1; then
        default_desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
        case "$default_desktop" in
                ''|dotfiles-browser.desktop)
                        ;;
                *)
                        gtk-launch "${default_desktop%.desktop}" "$@" && exit 0
                        ;;
        esac
fi

for browser_name in \
        firefox-esr \
        firefox \
        librewolf \
        chromium \
        chromium-browser \
        google-chrome-stable \
        google-chrome \
        brave-browser \
        vivaldi-stable \
        microsoft-edge-stable; do
        launch_browser "$browser_name" "$@" || true
done

message="No supported web browser was found. Set I3_BROWSER to its executable name."
printf '%s\n' "$message" >&2

if command -v dunstify >/dev/null 2>&1; then
        dunstify "Browser unavailable" "$message"
elif command -v notify-send >/dev/null 2>&1; then
        notify-send "Browser unavailable" "$message"
fi

exit 1
