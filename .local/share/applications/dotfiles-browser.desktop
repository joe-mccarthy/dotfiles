[Desktop Entry]
Type=Application
Name=Default Web Browser
Comment=Open links with the first available configured browser
Exec=i3-browser %U
TryExec=i3-browser
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
NoDisplay=true
